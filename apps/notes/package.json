{
  "name": "@zos-apps/notes",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "zos": {
    "id": "ai.hanzo.notes",
    "name": "Notes",
    "icon": "📝",
    "category": "productivity",
    "description": "Quick notes and markdown editor",
    "permissions": ["storage.local"],
    "window": {
      "defaultSize": { "width": 500, "height": 600 },
      "resizable": true
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "../../node_modules/tsgo/bin/tsc --noEmit --incremental false"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.3.5",
    "typescript": "6.0.3"
  }
}
